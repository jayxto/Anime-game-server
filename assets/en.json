  "rules": [
    {
      "pattern": "^(\\d+) citations$",
      "flags": "",
      "replacement": "$1 quotes"
    },
    {
      "pattern": "^Manche (\\d+)\\/(\\d+)$",
      "flags": "",
      "replacement": "Round $1/$2"
    },
    {
      "pattern": "^Manche (\\d+)$",
      "flags": "",
      "replacement": "Round $1"
    },
    {
      "pattern": "^Réponses : (\\d+)\\/(\\d+)$",
      "flags": "",
      "replacement": "Answers: $1/$2"
    },
    {
      "pattern": "^Palier (\\d+)\\/30$",
      "flags": "",
      "replacement": "Tier $1/30"
    },
    {
      "pattern": "^(\\d+) \\/ (\\d+) PV$",
      "flags": "",
      "replacement": "$1 / $2 HP"
    },
    {
      "pattern": "^(\\d+) pts$",
      "flags": "",
      "replacement": "$1 pts"
    },
    {
      "pattern": "^Erreurs : (\\d+)\\/(\\d+)$",
      "flags": "",
      "replacement": "Mistakes: $1/$2"
    },
    {
      "pattern": "^(\\d+) joueurs? en recherche en ce moment",
      "flags": "",
      "replacement": "$1 player(s) searching right now"
    },
    {
      "pattern": "^Série : (\\d+) jours?",
      "flags": "",
      "replacement": "Streak: $1 day(s)"
    },
    {
      "pattern": "^Jour (\\d+)\\/7 de ta série$",
      "flags": "",
      "replacement": "Day $1/7 of your streak"
    },
    {
      "pattern": "^(\\d+) \\/ (\\d+) persos$",
      "flags": "",
      "replacement": "$1 / $2 characters"
    },
    {
      "pattern": "^(\\d+) pièces$",
      "flags": "",
      "replacement": "$1 coins"
    },
    {
      "pattern": "^Booster (\\d+) cartes$",
      "flags": "",
      "replacement": "Booster $1 cards"
    },
    {
      "pattern": "^Univers : (.*)$",
      "flags": "",
