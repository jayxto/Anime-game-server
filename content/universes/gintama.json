{
  "key": "gintama",
  "name": "Gintama",
  "quotes": [
    {"text":"Je ne me bats pas pour le pays. Je protège ce qui se trouve à portée de mon sabre.","speaker":"Gintoki Sakata","recipient":"à Shinpachi","aliases":["Gintoki","Gin-chan","Gin-san","Shiroyasha"]},
    {"text":"Ce n'est pas Zura, c'est Katsura !","speaker":"Kotaro Katsura","recipient":"à Gintoki","aliases":["Katsura","Zura"]},
    {"text":"Gin-chan, j'ai faim, aru !","speaker":"Kagura","recipient":"à Gintoki","aliases":[]},
    {"text":"Je ne suis pas qu'une paire de lunettes !","speaker":"Shinpachi Shimura","recipient":"aux autres membres de la Yorozuya","aliases":["Shinpachi","Patsuan"]},
    {"text":"Sans mayonnaise, la vie n'a aucun goût.","speaker":"Toshiro Hijikata","recipient":"aux membres du Shinsengumi","aliases":["Hijikata","Démon vice-commandant"]},
    {"text":"Meurs, Hijikata.","speaker":"Sogo Okita","recipient":"à Hijikata","aliases":["Sogo","Okita"]},
    {"text":"Otae-san, épousez-moi !","speaker":"Isao Kondo","recipient":"à Tae Shimura","aliases":["Kondo","Gorille"]},
    {"text":"Je ne fais que détruire ce monde pourri.","speaker":"Shinsuke Takasugi","recipient":"à Katsura","aliases":["Takasugi"]},
    {"text":"Je ne tue pas les faibles. Ils pourraient devenir forts un jour.","speaker":"Kamui","recipient":"à Gintoki","aliases":[]},
    {"text":"Je ne suis pas un MADAO !","speaker":"Hasegawa Taizo","recipient":"à Gintoki","aliases":["Hasegawa","Madao"]}
  ],
