    {"text":"Merci de nous avoir tout appris, Koro-sensei.","speaker":"Nagisa Shiota","recipient":"à Koro-sensei","aliases":["Nagisa"]},
    {"text":"Je ne perds jamais deux fois contre le même adversaire.","speaker":"Karma Akabane","recipient":"à Gakushu","aliases":["Karma"]},
