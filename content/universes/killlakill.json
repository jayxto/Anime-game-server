  "quotes": [
    {"text":"Je cherche la personne qui a tué mon père.","speaker":"Ryuko Matoi","recipient":"à Satsuki","aliases":["Ryuko"]},
    {"text":"Senketsu, on y va !","speaker":"Ryuko Matoi","recipient":"à Senketsu","aliases":["Ryuko"]},
